{
  "id": "ida.app.sub",
  "name": "IDA脚本订阅",
  "author": "@IDA",
  "icon": "https://raw.githubusercontent.com/IDAz7/icons/main/icon/wk.png",
  "repo": "https://github.com/IDAz7",
  "apps": [
    {
      "id": "auto_ck_sync",
      "name": "通用同步CK至青龙",
      "keys": [
        "ql_base_url",
        "ql_client_id",
        "ql_client_secret",
        "ql_local_rules",
        "ql_api_token",
        "ql_api_token_expire",
        "ql_notification",
        "ql_debug"
      ],
      "settings": [
        {
          "id": "ql_base_url",
          "name": "青龙面板地址",
          "type": "text",
          "desc": "包含协议和端口，例如：http://192.168.1.5:5700"
        },
        {
          "id": "ql_client_id",
          "name": "应用 Client ID",
          "type": "text"
        },
        {
          "id": "ql_client_secret",
          "name": "应用 Client Secret",
          "type": "password"
        },
        {
          "id": "ql_local_rules",
          "name": "🏠 本地抓取规则 (JSON)",
          "type": "textarea",
          "autoGrow": true,
          "rows": 5,
          "desc": "填入本地规则JSON数组，优先读取。"
        },
        {
          "id": "ql_api_token",
          "name": "🔑 缓存的 API Token",
          "type": "text",
          "desc": "自动维护，请勿手动修改。"
        },
        {
          "id": "ql_api_token_expire",
          "name": "⏳ Token 过期时间戳",
          "type": "text",
          "desc": "自动维护的时间戳。"
        },
        {
          "id": "ql_notification",
          "name": "开启通知",
          "type": "boolean",
          "val": true
        },
        {
          "id": "ql_debug",
          "name": "开启调试日志",
          "type": "boolean",
          "val": false
        }
      ],
      "author": "@IDA",
      "icons": [
        "https://raw.githubusercontent.com/IDAz7/icons/main/icon/QL.png",
        "https://raw.githubusercontent.com/IDAz7/icons/main/icon/QL.png"
      ]
    },
    {
      "id": "Sliverkiss_QingLong",
